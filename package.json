{
  "name": "structured-product-payoff-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n riga,tac,web -c blue,magenta,green \"npm:backend:dev\" \"npm:mcp:http:tac\" \"npm:dev\"",
    "dev:http": "node scripts/dev-http.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:cpu": "tauri dev",
    "tauri:dev:cuda": "node scripts/tauri-cuda.mjs dev",
    "tauri:dev:stable-webview": "bash scripts/dev-linux-stable-webview.sh",
    "watch:renderer": "bash scripts/watch-renderer.sh",
    "tauri:build": "tauri build",
    "tauri:build:cpu": "tauri build",
    "tauri:build:cuda": "node scripts/tauri-cuda.mjs build",
    "mcp:sidecar:riga": "bash scripts/build-engine-sidecar.sh riga-flow riga-mcp RIGA_MCP_BIN",
    "mcp:sidecar:tac": "bash scripts/build-engine-sidecar.sh tac-engine tac-engine TAC_ENGINE_BIN",
    "mcp:sidecar:engines": "npm run mcp:sidecar:riga && npm run mcp:sidecar:tac",
    "mcp:http:tac": "node scripts/tac-mcp-http.mjs",
    "mcp:http:riga": "modules/riga-flow/target/release/riga-mcp --transport http --bind 127.0.0.1:8788 --allowed-host localhost --allowed-host 127.0.0.1",
    "mcp:http:engines": "concurrently -k -n riga,tac -c blue,magenta \"npm:mcp:http:riga\" \"npm:mcp:http:tac\"",
    "riga:fixture": "node scripts/record-transcripts.mjs riga",
    "smoke": "node scripts/smoke.mjs",
    "tac:fixture": "node scripts/record-transcripts.mjs tac",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "price:instrument": "node scripts/price-instrument.mjs",
    "backend:dev": "npm run mcp:http:riga",
    "backend:test": "cargo test --workspace",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.23",
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@faker-js/faker": "^10.6.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.12.1",
    "@types/react-grid-layout": "^1.3.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "echarts-gl": "^2.1.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "typebox": "^1.3.27",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
