{
  "name": "structured-product-payoff-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n backend,web -c blue,green \"npm:backend:dev\" \"npm:dev\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:stable-webview": "bash scripts/dev-linux-stable-webview.sh",
    "tauri:build": "tauri build",
    "mcp:sidecar": "bash scripts/build-mcp-sidecar.sh",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "backend:dev": "cargo run -p fina-server",
    "backend:test": "cargo test --workspace",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.23",
    "@codemirror/lang-markdown": "^6.5.2",
    "@earendil-works/pi-agent-core": "^1.0.1",
    "@earendil-works/pi-ai": "^1.0.1",
    "@earendil-works/pi-mcp": "^1.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tauri-apps/api": "^2.12.1",
    "@types/react-grid-layout": "^1.3.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.27",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
