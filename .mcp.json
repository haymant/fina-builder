{
  "mcpServers": {
    "riga-flow": {
      "type": "stdio",
      "command": "modules/target/release/riga-mcp",
      "args": ["--transport", "stdio"]
    },
    "tac-engine": {
      "type": "stdio",
      "command": "modules/target/release/tac-engine",
      "args": []
    },
    "tac-engine-dry-run": {
      "type": "stdio",
      "command": "modules/target/release/tac-engine",
      "args": [],
      "env": {
        "TAC_LAKE_DIR": "./lake",
        "TAC_DRY_RUN_FIXTURE": "./fixtures/tac-dry-run.json"
      }
    },
    "tac-qlib-rd": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/tac-qlib-mcp.mjs", "rd"]
    },
    "tac-qlib-book": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/tac-qlib-mcp.mjs", "book"]
    },
    "fina-scraper": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/fina-scraper-mcp.mjs"],
      "env": {
        "NIP_LAKE_DIR": "${NIP_LAKE_DIR}"
      }
    }
  }
}
