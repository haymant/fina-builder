{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Structured Product Payoff Explorer",
  "version": "0.1.0",
  "identifier": "com.fina.payoff-explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run mcp:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build && npm run mcp:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Structured Product Payoff Explorer",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/fina-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
